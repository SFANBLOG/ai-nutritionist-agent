# ============================================
# AI 营养师 Agent - 后端环境变量示例
# 复制为 .env 后按需修改(实际生效的是 .env 中的值)
# ============================================

# ---------- 数据库(默认 MySQL) ----------
# 默认使用 MySQL,与 docker-compose 中 mysql 服务凭据一致:
#   MYSQL_DATABASE=ai_nutritionist
#   MYSQL_USER=ai_user
#   MYSQL_PASSWORD=ai_password
# 本地裸机若无 MySQL,start.py 会自动探测并在不可达时回退 SQLite。
# 也可用下面任一行覆盖:
DATABASE_URL=mysql+pymysql://ai_user:ai_password@localhost:3306/ai_nutritionist?charset=utf8mb4
# DATABASE_URL=sqlite:///./data/ai_nutritionist.db

# ---------- JWT ----------
SECRET_KEY=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- LLM(兼容 OpenAI 协议) ----------
# 留空则进入规则引擎模式,完整走通四 Agent 工作流
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120

# ---------- Embedding(BGE 本地向量化) ----------
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# OPENAI_EMBEDDING_MODEL=

# ---------- 向量库(Milvus) ----------
# milvus | memory
VECTOR_DB_TYPE=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=nutrition_knowledge

# ---------- 对象存储(MinIO,留空走本地磁盘) ----------
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-nutritionist-uploads
MINIO_SECURE=false

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,http://127.0.0.1:5173

# ---------- Agent / 多日菜单 / HITL ----------
HUMAN_REVIEW_GATE=true
MAX_REVISION_REQUESTS=3
MENU_DEFAULT_DAYS=1
MENU_MAX_DAYS=7
