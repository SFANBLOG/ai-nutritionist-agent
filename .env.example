# 复制为 .env 后按环境填写；.env 不应提交到版本库。
# 生产环境必须生成随机密钥，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
LOG_LEVEL=INFO

# 可选 LLM。未填写时使用现有规则引擎回退。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 生产部署使用受管数据库，不使用 SQLite。
# DATABASE_URL=mysql+pymysql://user:password@db-host:3306/ai_nutritionist?charset=utf8mb4

# 仅填写实际会提供服务的前端域名，逗号分隔；不要使用 *。
# CORS_ORIGINS=https://nutrition.example.com
